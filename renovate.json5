{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  packageRules: [
    {
      // Helm chart dependency updates scoped to charts/
      matchManagers: ["helmv3"],
      matchFileNames: ["charts/**"],
      automerge: false,
      additionalBranchPrefix: "{{packageFileDir}}/",
      commitMessagePrefix: "chart({{packageFileDir}}):",
    },
  ],
  customManagers: [
    {
      // Track appVersion in Chart.yaml against container tags or GitHub releases.
      // Each Chart.yaml must annotate appVersion like:
      //   appVersion: "1.2.3" # renovate: datasource=docker depName=ghcr.io/org/app
      customType: "regex",
      fileMatch: ["charts/.+/Chart\\.yaml$"],
      matchStrings: [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\s*#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)",
      ],
      versioningScheme: "semver",
    },
  ],
}
